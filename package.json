{
  "name": "@fitchmultz/pi-stash",
  "version": "0.4.5",
  "description": "A pi extension for stashing draft messages and restoring them later.",
  "type": "module",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "stash",
    "draft"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-stash.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-stash/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-stash#readme",
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/stash.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "coverage": "node scripts/check-coverage.mjs",
    "policy": "node scripts/check-policy.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke-package-load.mjs",
    "check:compat": "node scripts/check.mjs --smoke",
    "prepublishOnly": "npm run check:compat"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "24.19.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.2.0"
}
